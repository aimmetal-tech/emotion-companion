# syntax=docker/dockerfile:1
# Pinned official Python and uv images; CUDA 12.4 libraries come from locked torch wheels.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711
ARG CACHE_SEED_IMAGE=${PYTHON_IMAGE}

FROM ${UV_IMAGE} AS uv
FROM ${CACHE_SEED_IMAGE} AS cache-seed
FROM ${PYTHON_IMAGE} AS base

LABEL org.opencontainers.image.title="Emotional Companion Training" \
      org.opencontainers.image.description="Locked single-GPU QLoRA training environment; not a competition submission image"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=42 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH" \
    HF_HOME=/workspace/.cache/huggingface \
    XDG_CACHE_HOME=/workspace/.cache \
    TRITON_CACHE_DIR=/workspace/.cache/triton \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /workspace

FROM base AS builder
# This index must match the registry already recorded in uv.lock. No re-resolution.
ARG UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,id=emotional-companion-uv,target=/root/.cache/uv \
    --mount=type=bind,from=cache-seed,source=/,target=/cache-seed,readonly \
    if [ -d /cache-seed/workspace/.cache/uv ]; then \
        cp -an /cache-seed/workspace/.cache/uv/. /root/.cache/uv/; \
    fi; \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_DEFAULT_INDEX="${UV_DEFAULT_INDEX}" \
    uv sync --locked --extra training --no-dev --no-editable --no-install-project

COPY README.md ./
COPY src/ ./src/
RUN --mount=type=cache,id=emotional-companion-uv,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_DEFAULT_INDEX="${UV_DEFAULT_INDEX}" \
    uv sync --locked --extra training --no-dev --no-editable

FROM base AS training
# Triton compiles its CUDA driver helpers when a GPU is first used, even though
# the Python wheels are already installed. Include C headers for an offline start.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
COPY pyproject.toml uv.lock requirements.txt README.md ./
COPY src/ ./src/
COPY configs/ ./configs/
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY official_dl/participant/ ./official_dl/participant/
COPY official_dl/test_inference_data.jsonl ./official_dl/test_inference_data.jsonl

RUN ln -s /opt/venv /workspace/.venv \
    && mkdir -p /workspace/models /workspace/artifacts /workspace/runs \
                /workspace/.cache /workspace/official_dl/train-val-dataset \
    && python -c "import torch, transformers, peft, bitsandbytes; print('torch', torch.__version__, 'CUDA', torch.version.cuda)" \
    && python -m emotional_companion --help

# No uv resolution, installation, or model download at container startup.
ENTRYPOINT ["python", "-m", "emotional_companion"]
CMD ["--help"]
